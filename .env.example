# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# MetaTrader 5 Webhook (optional)
MT5_WEBHOOK_URL=http://localhost:5000/webhook
MT5_WEBHOOK_SECRET=your_webhook_secret

# Trading Settings
DEFAULT_RISK_PERCENT=1.0
DEFAULT_RR_RATIO=2.0
MAX_OPEN_TRADES=3
ACCOUNT_BALANCE=10000.0

# Forex Data (optional - uses yfinance if empty)
ALPHA_VANTAGE_API_KEY=

# Telegram Bot (optional)
# 1. Create a bot via @BotFather on Telegram → get token
# 2. Add bot to your group or get your user ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_POLLING=true          # false if you use webhook instead
TELEGRAM_WEBHOOK_URL=          # https://your.domain/telegram/webhook

# Server
HOST=0.0.0.0
PORT=8000
